# Copy to .env and adjust. All settings are optional.

# HTTP port inside the container / for `npm start`
PORT=3000
# Where SQLite and uploaded files are stored (when not using Postgres/S3)
DATA_DIR=./data

# PostgreSQL instead of SQLite, e.g. postgres://user:pass@host:5432/whiteboard
DATABASE_URL=

# File storage: local (default) or s3
STORAGE=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=whiteboard
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Set to false after creating your account to stop others from registering
ALLOW_REGISTRATION=true
# Maximum upload size (images, rendered PDF pages) in MB
MAX_UPLOAD_MB=25
# Behind an HTTPS reverse proxy: mark cookies secure and trust X-Forwarded-*
COOKIE_SECURE=false
TRUST_PROXY=false
SESSION_DAYS=30
LOG_LEVEL=info

# Postgres/MinIO passwords used by docker-compose.postgres.yml
POSTGRES_PASSWORD=change-me
MINIO_PASSWORD=change-me-too
